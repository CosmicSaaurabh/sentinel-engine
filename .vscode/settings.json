{
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.import.maven.enabled": true,
  "java.import.generatesMetadataFilesAtProjectRoot": false,
  "java.maven.downloadSources": true,
  "java.eclipse.downloadSources": true,
  "java.autobuild.enabled": true,
  "java.server.launchMode": "Standard",
  "java.format.enabled": true,
  "java.format.settings.url": ".vscode/eclipse-java-formatter.xml",
  "java.format.settings.profile": "IntelliJ",
  "java.format.onType.enabled": true,
  "java.saveActions.organizeImports": true,
  "java.completion.importOrder": ["#", ""],
  "java.sources.organizeImports.starThreshold": 99,
  "java.sources.organizeImports.staticStarThreshold": 99,
  "java.referencesCodeLens.enabled": true,
  "java.implementationsCodeLens.enabled": true,
  "java.signatureHelp.enabled": true,
  "java.signatureHelp.description.enabled": true,
  "java.inlayHints.parameterNames.enabled": "literals",
  "java.inlayHints.parameterTypes.enabled": false,
  "java.inlayHints.variableTypes.enabled": false,
  "java.compile.nullAnalysis.mode": "automatic",
  "java.jdt.ls.java.home": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home",
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-21",
      "path": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home",
      "default": true
    },
    {
      "name": "JavaSE-17",
      "path": "/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home"
    },
    {
      "name": "JavaSE-25",
      "path": "/opt/homebrew/opt/openjdk@25/libexec/openjdk.jdk/Contents/Home"
    }
  ],
  "java.project.importOnFirstTimeStartup": "automatic",
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/.metadata/**",
    "**/archetype-resources/**",
    "**/META-INF/maven/**",
    "**/target/**"
  ],
  "maven.terminal.customEnv": [
    {
      "environmentVariable": "JAVA_HOME",
      "value": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home"
    }
  ],
  "terminal.integrated.env.osx": {
    "JAVA_HOME": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home"
  },
  "files.exclude": {
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.factorypath": true
  },
  "[java]": {
    "editor.defaultFormatter": "redhat.java",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "modificationsIfAvailable",
    "editor.formatOnType": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.rulers": [120],
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.wordBasedSuggestions": "off"
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml",
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  }
}
